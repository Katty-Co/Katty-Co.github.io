{
  // Cloudflare generates this file when it is absent. Committing it makes the
  // deploy reproducible and is the only way to set not_found_handling, which
  // is not exposed in the dashboard for a static-assets Worker.
  //
  // Values mirror what the dashboard was already using — do not change `name`
  // or the custom domains will detach from this Worker.
  "name": "katty-co-github-io",
  "compatibility_date": "2026-09-03",

  // The workers.dev URL is switched off deliberately; the site is reached at
  // kattyco.ca. Omitting these two re-enables them on every deploy — the first
  // build log warned about exactly that.
  "workers_dev": false,
  "preview_urls": true   // TEMPORARY: on for this branch only, so the 404 fix can be tested,

  "assets": {
    // Root directory is "/" in the build config, so assets are the repo root.
    // .assetsignore keeps .git, tools/, brand/ and the docs out.
    "directory": ".",

    // Serve /404.html for unmatched paths. Without this Cloudflare returns a
    // zero-byte 404, which reads as a broken site rather than a missing page.
    // GitHub Pages did this by default; Cloudflare does not.
    "not_found_handling": "404-page"
  }
}
