# Whitelist strategy: this working folder also holds ~2.6 GB of raw source
# photography and a 1.3 GB zip archive. Ignoring everything by default and
# opting files in makes it impossible to stage those by accident.

/*

# --- Tracked files ---
!/.gitignore
!/.gitattributes
!/.nojekyll
!/CLAUDE.md
!/README.md
!/robots.txt
!/sitemap.xml
!/brand/

# The built site: one folder per route, plus shared assets.
!/index.html
!/about/
!/booking/
!/faq/
!/pack/
!/reviews/
!/services/
!/assets/
!/img/

# The compiler that produces the above.
!/tools/

# ...but not its dependencies or its intermediate captures.
/tools/node_modules/
/tools/captured/
/tools/package-lock.json

# Never track, even if moved inside a whitelisted folder
.DS_Store
Thumbs.db
node_modules/
*.zip
*.mov
*.MOV
*.mp4
*.heic
*.HEIC
